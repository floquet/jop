SHELL    := /bin/bash
CXX      := g++
CXXFLAGS := -std=c++17 -O3 -DNDEBUG -Wall -Wextra

# Extract unique Spack prefixes already loaded in CMAKE_PREFIX_PATH
SPACK_PREFIXES := $(sort $(subst :, ,$(CMAKE_PREFIX_PATH)))

INC_DIRS := $(foreach p,$(SPACK_PREFIXES),-isystem $(p)/include) -isystem /usr/include/eigen3
LIB_DIRS := $(foreach p,$(SPACK_PREFIXES),-L$(p)/lib -L$(p)/lib64)
RPATHS   := $(foreach p,$(SPACK_PREFIXES),-Wl,-rpath,$(p)/lib -Wl,-rpath,$(p)/lib64)

LDLIBS   := -lpagmo -ltbb -lpthread

HOST     := $(shell hostname)
TARGETS  := pagmo-rosenbrock-de pagmo-rosenbrock-stress

all: $(TARGETS)

%: %.cpp provenance.hpp
	$(CXX) $(CXXFLAGS) $(INC_DIRS) $< $(LIB_DIRS) $(RPATHS) $(LDLIBS) -o $@

# Run any target directly: e.g., make run-pagmo-rosenbrock-de
run-%: %
	./$<

# Compile, run, and tee output to <target>-<hostname>.log (preserving exit code):
# e.g., make log-pagmo-rosenbrock-stress
log-%: %
	set -o pipefail; ./$< 2>&1 | tee $<_$(HOST).log

# Build and log all targets
logs: $(addprefix log-,$(TARGETS))

clean:
	rm -f $(TARGETS) *.log

.PHONY: all logs clean

MPICXX    := mpicxx
MPIRUN    := mpirun
MPI_RANKS ?= 4

pagmo-rosenbrock-mpi: pagmo-rosenbrock-mpi.cpp provenance.hpp
	$(MPICXX) $(CXXFLAGS) $(INC_DIRS) $< $(LIB_DIRS) $(RPATHS) $(LDLIBS) -o $@

run-mpi: pagmo-rosenbrock-mpi
	env -u DISPLAY -u XAUTHORITY $(MPIRUN) -np $(MPI_RANKS) ./pagmo-rosenbrock-mpi

log-mpi: pagmo-rosenbrock-mpi
	set -o pipefail; HWLOC_COMPONENTS=-gl $(MPIRUN) -bind-to none -np $(MPI_RANKS) ./pagmo-rosenbrock-mpi 2>&1 | tee pagmo-rosenbrock-mpi_$(HOST)_np$(MPI_RANKS).log
